# Скопируйте этот файл в local.properties (файл local.properties уже добавлен в .gitignore)
# и укажите путь к Android SDK и реальные ID рекламных блоков из кабинета РСЯ.
#
# ВАЖНО:
# - Пустая строка отключает соответствующий рекламный формат (игра полностью работает без рекламы).
# - НИКОГДА не вставляйте demo-banner-yandex / demo-rewarded-yandex в release-сборку
#   (приложение дополнительно блокирует любые demo-* ID в release автоматически).

# sdk.dir=/path/to/Android/Sdk

# ID адаптивного баннера (отображается ТОЛЬКО внизу главного меню)
yandex.banner.id=

# ID полноэкранного вознаграждаемого видео (Rewarded: возрождение и пропуск ожидания)
yandex.rewarded.id=

# Включить официальные демо-блоки Яндекса ТОЛЬКО в debug-сборке (true/false; в release игнорируется)
yandex.debug.demo=false
